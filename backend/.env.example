# Annadata Backend Environment Configuration

# Server Port (Render sets this automatically to 10000)
PORT=5000
NODE_ENV=production

# MongoDB Atlas Database URI
# Example: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/annadata?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/annadata

# Allowed CORS Origin(s) (Comma separated or * for all)
# Example: https://annadata.vercel.app,http://localhost:3000
CORS_ORIGIN=*

# Optional Geocoding API Key (OpenStreetMap Nominatim is used by default)
GEOCODING_API_KEY=
